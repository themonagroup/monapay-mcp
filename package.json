{
  "name": "monapay-mcp",
  "version": "0.4.0",
  "description": "MCP server cho MONA Pay — để Claude Code / Cursor / Codex tạo QR, tra giao dịch, cấu hình webhook MONA Pay ngay trong lúc code. MONA Pay là cổng thanh toán và API ngân hàng của The MONA Group.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "monapay-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "mcp-manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "start": "node dist/index.js",
    "manifest": "node scripts/gen-manifest.mjs",
    "prepublishOnly": "npm run build && npm run manifest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "monapay",
    "vietqr",
    "webhook",
    "email",
    "payment",
    "vietnam",
    "acb",
    "claude-code",
    "cursor",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/monapay/monapay-mcp"
  },
  "homepage": "https://monapay.vn/ai-agent",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
